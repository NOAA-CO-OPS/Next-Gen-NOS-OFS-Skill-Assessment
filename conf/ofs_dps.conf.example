#
# OFS Data Processing System Config
# Master configuration File
#
# PARAMETER values are set as PARAMETER=value.
# Any comments must start with a # and must be on a
# separate line. Parameter names must be unique and must
# start at the beginning of a line. Parameters are grouped
# and denoted by [groupname] at the start of a set of parameters.
# Parameters in a group should have a 2-5 character prefix for the
# area they belong to, for example database specific stuff is
# prefixed by DB_.
#
# Note: keys are case-insensitive and stored in lowercase

[directories]
#-- Directory info and other config parameters ------------------------

# Application home directory - other directories will be subdirs
# to home, denoted by %(home)s

home=/path/to/sa_homedir/

# Directory settings below may be either:
#   - relative (default): created as subdirectories of the working
#     directory (the -p command line argument, or home= when -p is
#     not given), e.g. data_dir=data
#   - absolute: used as-is, e.g. data_dir=/mnt/bigdisk/ofs_data.
#     Use this to write output to another disk when the installation
#     location has limited space. A leading ~ is expanded.
# Input assets that ship with the installation (ofs_extents/, conf/)
# are always found automatically - they never need to be copied to
# the output location.

# Data directory - the bulk of the output (model data, observations,
# skill statistics, plots) is written here
#data_dir=%(home)s/data/
data_dir=data

# OFS directories
ofs_extents_dir=ofs_extents
# Control files directory - station control files, inventories, and
# station ledgers are written here (relative or absolute, see above)
control_files_dir=control_files
observations_dir=observations
1d_station_dir=1d_station
2d_satellite_dir=2d_satellite
2d_satellite_ice_dir=2d_satellite_ice
model_dir=model
skill_dir=skill
model_historical_dir=%(home)s/example_data
model_obc_dir=%(home)s/example_data
netcdf_dir=netcdf
1d_node_dir=1d_node
horizon_model_dir=horizon_model
model_icesave_dir=2D_ice_cover
1d_pair_dir=1d_pair
1d_ice_pair_dir=1d_ice_pair
1d_horizon_pair_dir=1d_horizon_pair
stats_dir=stats
stats_ice_dir=ice_stats
visual_dir=visual
visual_ice_dir=ice_visual
visual_ice_time_series=time_series
visual_ice_static_maps=static_maps
visual_ice_json_maps=json_maps
visual_ice_stats=stats
visual_horizon_dir=horizon_visual
visual_maps=plotly_maps
om_dir=om_files
om_dir_ice=om_files_ice
tidal_analysis_dir=tidal_analysis
model_historical_dir_backup=Add_model_historical_dir_backup



[vdatum]
# Force online PROJ network streaming mode
online = true

# Retry attempts for S3 grid fetching before falling back
max_retries = 5

# Timeout setting for HTTP grid requests (in seconds)
network_timeout = 30

# Local fallback path for the vertical datum NetCDF file. Only used if the
# vdatum file cannot be read from the NODD S3 bucket (noaa-nos-ofs-pds).
# Set this to the full path of a local copy of {ofs}_vdatums.nc.
local_vdatum = Add_path_to/file.nc

# Cache directory for model files streamed from the NODD S3 buckets.
# Streamed files can accumulate several GB here, so point this at a
# large disk if your home directory has a size quota. Leave commented
# out (or blank) to use the default of ~/.ofs_cache/s3
#s3_cache_dir=/path/to/large_disk/ofs_cache

[urls]
# Station URLs
co_ops_mdapi_base_url=https://api.tidesandcurrents.noaa.gov/mdapi/prod/
co_ops_api_base_url=https://api.tidesandcurrents.noaa.gov/api/prod/
usgs_nwls_inventory_url=https://waterdata.usgs.gov/nwis/
usgs_nwis_url=https://nwis.waterservices.usgs.gov/nwis/iv/
ndbc_noaa_url=https://www.ndbc.noaa.gov/
ndbc_station_metadata_url=%(ndbc_noaa_url)s/metadata/stationmetadata.xml
glsea_thredds=https://apps.glerl.noaa.gov/thredds/fileServer/glsea_ice_nc/
glsea_erddap=https://apps.glerl.noaa.gov/erddap/files/GL_Ice_Concentration_GCS/
nodd_s3=https://noaa-nos-ofs-pds.s3.amazonaws.com/
nodd_s3_stofs3d = https://noaa-nos-stofs3d-pds.s3.amazonaws.com/
nodd_s3_stofs2d = https://noaa-gestofs-pds.s3.amazonaws.com/
#sat urls
nesdis_thredds=https://www.star.nesdis.noaa.gov/thredds/fileServer/
nesdis_n20=https://www.star.nesdis.noaa.gov/pub/socd2/coastwatch/sst/nrt/viirs/n20/l3u
nesdis_n21=https://www.star.nesdis.noaa.gov/pub/socd2/coastwatch/sst/nrt/viirs/n21/l3u
nesdis_npp=https://www.star.nesdis.noaa.gov/pub/socd2/coastwatch/sst/nrt/viirs/npp/l3u
nesdis_coastwatch=https://www.star.nesdis.noaa.gov/data/pub0053/coastwatch/sst/l3s
nesdis_dodsC=https://www.star.nesdis.noaa.gov/thredds/dodsC
nssr_sport=https://nssrgeo.ndc.nasa.gov/SPoRT/enhanced_sst/ghrsst_netcdf


[datums]
# List of vertical datums that the program can convert between. If a new datum
# is added to the package, include it here!
datum_list=MHHW MHW MLLW MLW NAVD88 IGLD85 LWD XGEOID20B MSL


[station_IDs]
# Optional input list of observation station IDs to assess.
# This list can only be actiavted by using the `list` argument
# for the flag -so --Station_Owner:
# `-so list`
# OR
# `--Station_Owner list`
# If using `-so list` and the list below is blank, the skill
# assessment will include all stations found in an OFS.
station_ID_list=8551910 8571421


[user_xy_inputs]
# Optional path to text file of coordinates that can be
# used in get_node_ofs.py to extract model time series at
# specific coordinates. Each line in file should correspond
# to one location. Formatting is as follows:
#
# location_name latitude longitude waterdepth
#
# where lat & lon are decimal degrees and depth is m.
# For example:
#    myloc1 39.582 -75.589 0
#    myloc2 37.996 -76.464 2
user_xy_path=path/to/filename.txt


[parallelization]
# -----------------------------------------------------------------------
# Parallelization settings
#
# All worker count settings accept either a positive integer or "auto".
# "auto" scales the worker count based on your system's CPU count:
#   - I/O-bound tasks (obs retrieval, model download, plotting, skill):
#     scales up to ~2x CPU count, since threads mostly wait on network/disk
#   - CPU-bound tasks (harmonic analysis): uses cpu_count - 1, capped at 8
#
# Set parallel_enabled=False to disable all parallelization and run
# everything sequentially (all worker counts forced to 1).
# -----------------------------------------------------------------------

parallel_enabled=True

# Observation retrieval (ThreadPoolExecutor, I/O-bound)
# CO-OPS and NDBC APIs handle concurrent requests well; USGS and CHS
# are rate-limited, so fewer workers are recommended.
obs_coops_workers=auto
obs_usgs_workers=auto
obs_ndbc_workers=auto
obs_chs_workers=auto

# Model file downloads from NODD S3 (ThreadPoolExecutor, I/O-bound)
model_download_workers=auto

# Skill assessment station pairing + metrics (ThreadPoolExecutor, I/O-bound)
skill_workers=auto

# Harmonic analysis (ProcessPoolExecutor, CPU-bound)
# Uses separate processes for utide, which releases the GIL.
ha_workers=auto

# Station plot generation (ThreadPoolExecutor, I/O-bound)
plot_workers=auto

# Variable-level parallelism (experimental)
# Process multiple variables (wl, temp, salt, cu) concurrently within
# a single pipeline stage. Only enable if you have sufficient memory.
parallel_variables=False

# Max concurrent model-data extractions (dask.compute calls) across the
# variable threads when parallel_variables=True. Only takes effect when
# the model files are NetCDF-4/HDF5 (read via the thread-safe h5netcdf
# engine); NetCDF-3 files are always extracted one variable at a time.
# Each slot holds one variable's data in memory during extraction
# (roughly 4-5 GB for a multi-month run of a large OFS), so raise this
# only if you have RAM to spare. 1 = fully serialized extraction.
parallel_extract_slots=2

# CO-OPS API rate limiting. The process-wide limiter allows
# coops_request_concurrency simultaneous requests and spaces request
# starts by coops_request_gap_sec seconds. The defaults (2 / 0.5) were
# tuned against CO-OPS throttling on long historical windows — raising
# them speeds up observation retrieval but risks HTTP 403 chunk drops
# if CO-OPS throttles your IP. Note obs_coops_workers above this limit
# adds no throughput; the limiter is the effective cap.
coops_request_concurrency=2
coops_request_gap_sec=0.5

# Workflow-level parallelism: run obs download + model extraction concurrently
parallel_workflow=False

# Station-level parallelism: process stations in parallel during model extraction
parallel_stations=False

# Plotting parallelism: generate station plots in parallel
parallel_plotting=False

# Forecast cycle parallelism: process forecast_a cycles concurrently
parallel_forecast_cycles=False

# Obs variable parallelism: download obs for all variables concurrently
parallel_obs_variables=False

# 2D interpolation parallelism: run IDW interpolation for variables in parallel
parallel_2d_interp=False


[settings]
# Would you like to make static (.png) station plots in addition to
# the interactive plotly plots?
# True = both static & interactive plots
# False = just interactive plots
static_plots=False

# NODD S3 bucket usage for model files. Three modes:
#   True  = prefer local model files; read from the NODD S3 bucket only
#           when local files are missing (recommended default)
#   False = local files only; exit with error if local files are missing
#           (original behavior)
#   force = always read model files from the NODD S3 bucket, even when
#           local files are present (useful for validating against the
#           canonical NODD copy)
use_s3_fallback=True

# Use a custom list of model files?
# True = load filenames from user-provided text file
# False = default; SA will fetch file names either from the S3 bucket, or locally
# If True, set 'filename_path' to the path to your text file, including the filename.
use_custom_filenames=False
filename_path=path/to/filename.txt

# Maximum assessment window (in days) allowed when forecast-horizon skill
# (-hs / --Horizon_Skill) is enabled. Runs longer than this auto-disable the
# horizon skill option to guard against very long run times. The horizon
# workflow scales roughly linearly with the number of model cycles in the
# window (~cycles_per_day * days), so raise this if you want week+ horizon
# skill and can accept the longer run time.
horizon_max_days=2

# Make the extra forecast-horizon-skill plots? Only applies when
# forecast-horizon skill (-hs / --Horizon_Skill) is enabled. These are the
# per-station model-cycle time-series plots (with a model-cycle dropdown) and
# the pass/fail central-frequency scorecards. Disabled by default because they
# add run time and produce many files (esp. per-station currents scorecards).
# True = also make the time-series + scorecard plots
# False = just the standard RMSE / central-frequency bar plots
horizon_extra_plots=False

# Maximum distance (km) between an observation station and its nearest model
# output location for the two to be paired in the skill assessment. Stations
# whose nearest model location is farther than this are not assessed.
# The same value is used to size the candidate search box, so it is applied
# consistently across both the pre-filter and the final match test.
# Keep this tight: proximity matters for the validity of the comparison.
# Default is 4 km if this key is omitted.
# Scope: applies to stations-filetype runs (-t stations) only. Fields runs
# match each station to the nearest wet grid node with no distance cutoff,
# and STOFS stations files are matched by station name, not distance.
station_match_max_dist_km=4.0

# NetCDF engine selection for reading model files. Three modes:
#   auto     = detect each batch's on-disk format from its magic bytes
#              (recommended default). NetCDF-4/HDF5 files are read with
#              the thread-safe h5netcdf engine, which allows concurrent
#              variable extraction (see parallel_extract_slots);
#              NetCDF-3 files (e.g. NECOFS, stofs_2d_glo stations) are
#              read with the netcdf4 or scipy engine and extracted
#              serially.
#   netcdf4  = force the netcdf4 engine for every open (reads all
#              formats, fully serialized extraction)
#   h5netcdf = force the h5netcdf engine (NetCDF-4/HDF5 files only;
#              fails on NetCDF-3 files)
engine_strategy=auto

# Ctl-file creation decides per-bin CO-OPS ADCP currents availability
# with short probe requests (one full-window scan per station plus one
# short confirmation per bin) instead of downloading the full window
# for every bin — the ctl stage only needs a yes/no per bin, and the
# full downloads dominated multi-month run times. Set False to restore
# the full-download scan (e.g. to cross-check probe decisions).
ctl_availability_probe=True
